{
  "name": "@every-dagent/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Every-DAgent web transport binding: a node:http server and a fetch/SSE client channel that carry protocol frames as text, without knowing what they mean.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {
    "@every-dagent/protocol": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/http-channel.ts",
      "default": "./src/client/http-channel.ts"
    },
    "./server": {
      "types": "./src/server/http-binding.ts",
      "default": "./src/server/http-binding.ts"
    }
  }
}
