{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node"]
  },
  "include": ["packages", "apps", "tests"],
  "exclude": ["apps/web/src/browser", "apps/web/tests/shell-rendering.test.tsx", "apps/web/dist"]
}
